{
  "expo": {
    "name": "lib",
    "slug": "lib",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lib",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mdp.lib",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mdp.lib",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "../../node_modules/@expo-google-fonts/inter/Inter_900Black.ttf",
            "../../node_modules/@expo-google-fonts/inter/Inter_700Bold.ttf",
            "../../node_modules/@expo-google-fonts/inter/Inter_500Medium.ttf",
            "../../node_modules/@expo-google-fonts/inter/Inter_400Regular.ttf",
            "../../node_modules/@expo-google-fonts/inter/Inter_300Light.ttf",
            "../../node_modules/@expo-google-fonts/inter/Inter_100Thin.ttf"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
